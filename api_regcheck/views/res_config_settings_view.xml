<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="biluppgifter_res_config_settings_view_form" model="ir.ui.view">
            <field name="name">fleet_reg_common.res.config.settings.view.form.inherit</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="fleet_reg_common.fleet_reg_common_res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//span[@id='fleet_reg_common']" position="after">
                    <h2>RegCheck API</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-xs-12 col-md-6 o_setting_box" id="reg_check_username">
                            <div class="o_setting_right_pane">
                                <label string="Username" for="vehicle_api_username"/>
                                <div class="mt16">
                                    <field name="vehicle_api_username" required="1"/>
                                </div>
                                <div class="text-muted">Fill in the Reg Check Username</div>
                            </div>
                        </div>

                        <div class="col-xs-12 col-md-6 o_setting_box" id="reg_check_password">
                            <div class="o_setting_right_pane">
                                <label string="Password" for="vehicle_api_password"/>
                                <div class="mt16">
                                    <field name="vehicle_api_password" required="1"/>
                                </div>
                                <div class="text-muted">Fill in the Reg Check Password</div>
                            </div>
                        </div>

                        <div class="col-xs-12 col-md-12 o_setting_box" id="reg_check_url">
                            <div class="o_setting_right_pane">
                                <label string="RegCheck URL" for="reg_check_url"/>
                                <div class="mt16">
                                    <field name="reg_check_url" required="1"/>
                                </div>
                                <div class="text-muted">Fill in the Reg Check URL</div>
                            </div>
                        </div>
                    </div>

                </xpath>
            </field>
        </record>
    </data>
</odoo>

