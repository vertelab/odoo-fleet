<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="carinput" inherit_id="website_calendar_ce.index">
            <xpath expr="//div[@id='wrap']/div[contains(@class, 'o_website_calendar_booking')]" position="inside">
                <form class="o_website_appointment_form">
                    <div class="form-group row" style="text-align: end;">
                        <div class="offset-md-8 col-md-6">
                            <button type="submit" class="btn btn-primary">View Availabilities <span class="fa fa-arrow-right"/></button>
                        </div>
                    </div>
                </form>
            </xpath>
    </template>

    <template id="vehicle_search" inherit_id="website_calendar_ce.index">
        <xpath expr="//div[@id='wrap']/div[hasclass('o_website_calendar_booking')]/ul[1]/li[1]" position="attributes">
            <li class="text-primary">Search<span class="chevron"/></li>
        </xpath>
        <xpath expr="//div[@id='wrap']/div[hasclass('o_website_calendar_booking')]/form[hasclass('o_website_appointment_form')]" position="attributes">
            <attribute name="t-attf-action">/website/calendar/search</attribute>
        </xpath>

    </template>

    <template id="carinput" name="Website booking: Booking Page">
        <t t-call="website.layout">
            <div id="wrap" class="o_website_calendar">
                <div class="oe_structure"/>
                <div class="container mb128">
                </div>
            </div>
        </t>
    </template>
</odoo>
