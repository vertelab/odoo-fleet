<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_fleet_vehicle_form" model="ir.ui.view">
        <field name="name">fleet.vehicle.form</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//sheet/div[@name='button_box']" position="inside">
                <button name="action_view_asset" class="oe_stat_button" icon="fa-bars" invisible="not asset_id" type="object" string="Assets"/>
                <button name="action_view_loan" class="oe_stat_button" icon="fa-pencil-square-o" type="object" string="Loans">
                    <field name="account_loan_count" widget="statinfo" string="Loans"/>
                </button>
            </xpath>
        </field>
    </record>

</odoo>