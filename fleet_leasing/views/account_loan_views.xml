<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_loan_form" model="ir.ui.view">
        <field name="name">account.loan.form</field>
        <field name="model">account.loan</field>
        <field name="inherit_id" ref="account_loan.account_loan_form" />
        <field name="arch" type="xml">
            <xpath expr="//sheet/div[@name='button_box']" position="inside">
                <button name="action_view_vehicle" class="oe_stat_button" icon="fa-bars" invisible="not vehicle_id" type="object" string="Vehicle"/>
            </xpath>
        </field>
    </record>

</odoo>